{% extends 'kb/deployment/base.html' %}

{% block extra_css %}
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.13/css/select2.min.css" rel="stylesheet" />
<style>
.card.h-100 {
    transition: all 0.3s ease;
}

.card.h-100:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
}

#server-preview .card {
    border-left: 4px solid #007bff;
}

#file-info input[readonly] {
    background-color: #f8f9fa;
    cursor: not-allowed;
}

.form-switch .form-check-input:checked {
    background-color: #198754;
    border-color: #198754;
}

/* 项目搜索样式 */
.project-search-results {
    position: absolute;
    z-index: 1000;
    width: calc(100% - 30px);
    max-height: 200px;
    overflow-y: auto;
    background: white;
    border: 1px solid #dee2e6;
    border-radius: 0 0 0.375rem 0.375rem;
    box-shadow: 0 0.5rem 1rem rgba(0,0,0,.15);
    margin-top: -1px;
}

.project-search-results .list-group {
    border: none;
}

.project-search-results .list-group-item {
    border-left: none;
    border-right: none;
    cursor: pointer;
}

.project-search-results .list-group-item:first-child {
    border-top: none;
}

.project-search-results .list-group-item:last-child {
    border-bottom: none;
}

/* 虚拟机健康检查表格 */
#health-check-result .table {
    margin-bottom: 0;
}

#health-check-result .table-danger {
    background-color: rgba(220, 53, 69, 0.1);
}

/* 禁用按钮样式 */
#submit-btn:disabled {
    opacity: 0.65;
    cursor: not-allowed;
}

/* 进度条百分比显示 */
.progress-bar {
    position: relative;
}

.progress-bar span {
    position: absolute;
    right: 10px;
    color: #fff;
    font-weight: bold;
    text-shadow: 1px 1px 1px rgba(0,0,0,0.5);
}

/* 响应式调整 */
@media (max-width: 768px) {
    .project-search-results {
        width: 100%;
    }
}
</style>
{% endblock %}

{% block breadcrumb %}
<li class="breadcrumb-item"><a href="{% url 'project_list' %}">项目管理</a></li>
<li class="breadcrumb-item active" aria-current="page">上传更新包</li>
{% endblock %}

{% block deployment_content %}
<div class="card deployment-card">
    <div class="card-header">
        <h4 class="card-title mb-0">
            <i class="fas fa-upload"></i> {{ title }}
        </h4>
    </div>
    
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" id="upload-form">
            {% csrf_token %}
            
            {% if form.non_field_errors %}
            <div class="alert alert-danger">
                {% for error in form.non_field_errors %}
                {{ error }}
                {% endfor %}
            </div>
            {% endif %}
            
            <!-- 上传进度 -->
            <div class="progress mb-4" id="upload-progress" style="display: none;">
                <div class="progress-bar progress-bar-striped progress-bar-animated" 
                     role="progressbar" style="width: 0%">
                    <span>0%</span>
                </div>
            </div>
            
            <!-- 基本信息 -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-info-circle"></i> 基本信息
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- 项目选择（搜索模式） -->
                        <div class="col-md-6 mb-3">
                            <label for="project-search" class="form-label">
                                项目 <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="text" 
                                       class="form-control" 
                                       id="project-search"
                                       placeholder="输入项目名称或代号搜索..."
                                       autocomplete="off">
                                <button class="btn btn-outline-secondary" type="button" id="project-search-btn">
                                    <i class="fas fa-search"></i>
                                </button>
                            </div>
                            <div class="project-search-results mt-2" style="display: none;">
                                <div class="list-group" style="max-height: 200px; overflow-y: auto;"></div>
                            </div>
                            <input type="hidden" name="project" id="selected-project-id" value="{{ form.project.value|default:'' }}">
                            <div class="mt-2" id="selected-project-info" style="display: none;">
                                <div class="alert alert-success py-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <strong id="selected-project-name"></strong>
                                            <small class="text-muted ms-2" id="selected-project-code"></small>
                                        </div>
                                        <button type="button" class="btn btn-sm btn-outline-danger" id="clear-project">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>
                                    <div class="small mt-1">
                                        <span class="badge bg-info" id="selected-project-vm-count">0</span> 个虚拟机
                                        <span class="ms-2" id="selected-project-status"></span>
                                    </div>
                                </div>
                            </div>
                            {% if form.project.errors %}
                            <div class="text-danger small mt-1">{{ form.project.errors }}</div>
                            {% endif %}
                            <div class="form-text">选择项目后，包将自动更新到该项目下的所有在线服务器</div>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="{{ form.package_type.id_for_label }}" class="form-label">
                                {{ form.package_type.label }} <span class="text-danger">*</span>
                            </label>
                            <select name="{{ form.package_type.name }}" id="{{ form.package_type.id_for_label }}" 
                                    class="form-select" required>
                                <option value="">请选择包类型</option>
                                <option value="java_full" {% if form.package_type.value == 'java_full' %}selected{% endif %}>Java全量包(pcms.war)</option>
                                <option value="java_incremental" {% if form.package_type.value == 'java_incremental' %}selected{% endif %}>Java增量包(pcms.zip)</option>
                                <option value="cpp_program" {% if form.package_type.value == 'cpp_program' %}selected{% endif %}>C++程序(pcms)</option>
                                <option value="h5_package" {% if form.package_type.value == 'h5_package' %}selected{% endif %}>H5包(confApp.zip)</option>
                                <option value="java_log_full" {% if form.package_type.value == 'java_log_full' %}selected{% endif %}>Java日志全量包(pcmsLog.war)</option>
                                <option value="java_log_incremental" {% if form.package_type.value == 'java_log_incremental' %}selected{% endif %}>Java日志增量包(pcmsLog.zip)</option>
                            </select>
                            {% if form.package_type.errors %}
                            <div class="text-danger small mt-1">{{ form.package_type.errors }}</div>
                            {% endif %}
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="{{ form.version.id_for_label }}" class="form-label">
                                {{ form.version.label }} <span class="text-danger">*</span>
                            </label>
                            {{ form.version }}
                            {% if form.version.errors %}
                            <div class="text-danger small mt-1">{{ form.version.errors }}</div>
                            {% endif %}
                            <div class="form-text">版本号格式如: V3.0.1, 2024.01.15</div>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="{{ form.file.id_for_label }}" class="form-label">
                                {{ form.file.label }} <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="file" class="form-control" id="{{ form.file.id_for_label }}" name="{{ form.file.name }}" required>
                            </div>
                            {% if form.file.errors %}
                            <div class="text-danger small mt-1">{{ form.file.errors }}</div>
                            {% endif %}
                            <div class="form-text">支持的文件: .war, .zip, 可执行文件等，最大1GB</div>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="{{ form.description.id_for_label }}" class="form-label">
                            {{ form.description.label }}
                        </label>
                        {{ form.description }}
                        {% if form.description.errors %}
                        <div class="text-danger small mt-1">{{ form.description.errors }}</div>
                        {% endif %}
                        <div class="form-text">包的描述信息，如更新内容说明</div>
                    </div>
                </div>
            </div>
            
            <!-- 虚拟机健康状态检查 -->
            <div class="card mb-4" id="vm-health-check" style="display: none;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-heartbeat"></i> 虚拟机状态检查
                        <span id="health-status-badge" class="badge bg-success ms-2">正常</span>
                    </h5>
                </div>
                <div class="card-body">
                    <div id="health-check-result">
                        <!-- 虚拟机状态将在这里显示 -->
                    </div>
                    <div class="alert alert-danger mt-3" id="unhealthy-vms-alert" style="display: none;">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <i class="fas fa-exclamation-triangle fa-2x"></i>
                            </div>
                            <div class="flex-grow-1 ms-3">
                                <h5 class="alert-heading">虚拟机状态异常！</h5>
                                <p>以下虚拟机未在运行状态，无法执行更新：</p>
                                <ul id="unhealthy-vms-list" class="mb-2"></ul>
                                <p class="mb-0"><strong>请先检查虚拟机状态并启动虚拟机，然后再进行更新操作。</strong></p>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-success" id="all-healthy-alert" style="display: none;">
                        <i class="fas fa-check-circle"></i> 所有虚拟机都在运行状态，可以执行更新。
                    </div>
                </div>
            </div>
            
            <!-- 服务器预览 -->
            <div class="card mb-4" id="server-preview" style="display: none;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-server"></i> 目标虚拟机
                        <span class="badge bg-info ms-2" id="server-count">0</span>
                    </h5>
                    <p class="text-muted mb-0 mt-1">包将自动更新到以下虚拟机</p>
                </div>
                <div class="card-body">
                    <div id="server-list" class="row"></div>
                    <div class="alert alert-warning mt-3" id="no-servers-alert" style="display: none;">
                        <i class="fas fa-exclamation-triangle"></i> 
                        该项目下没有虚拟机
                    </div>
                </div>
            </div>
            
            <!-- 文件信息 -->
            <div class="card mb-4" id="file-info-card" style="display: none;">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-file-alt"></i> 文件信息
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">文件名</label>
                                <input type="text" class="form-control" id="file-name" readonly>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">文件大小</label>
                                <input type="text" class="form-control" id="file-size" readonly>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label">文件类型</label>
                                <input type="text" class="form-control" id="file-type" readonly>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            
            <div class="mt-4">
                <button type="submit" class="btn btn-primary" id="submit-btn" disabled>
                    <i class="fas fa-upload"></i> 上传并更新
                </button>
                <a href="{% url 'project_list' %}" class="btn btn-secondary">
                    <i class="fas fa-times"></i> 取消
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    // 元素引用
    const projectSearchInput = document.getElementById('project-search');
    const projectSearchBtn = document.getElementById('project-search-btn');
    const projectSearchResults = document.querySelector('.project-search-results');
    const selectedProjectId = document.getElementById('selected-project-id');
    const selectedProjectInfo = document.getElementById('selected-project-info');
    const selectedProjectName = document.getElementById('selected-project-name');
    const selectedProjectCode = document.getElementById('selected-project-code');
    const selectedProjectVmCount = document.getElementById('selected-project-vm-count');
    const selectedProjectStatus = document.getElementById('selected-project-status');
    const clearProjectBtn = document.getElementById('clear-project');
    
    const fileInput = document.getElementById('{{ form.file.id_for_label }}');
    const versionInput = document.getElementById('{{ form.version.id_for_label }}');
    const packageTypeSelect = document.getElementById('{{ form.package_type.id_for_label }}');
    const serverPreview = document.getElementById('server-preview');
    const serverList = document.getElementById('server-list');
    const noServersAlert = document.getElementById('no-servers-alert');
    const serverCount = document.getElementById('server-count');
    const fileInfoCard = document.getElementById('file-info-card');
    const uploadProgress = document.getElementById('upload-progress');
    const progressBar = uploadProgress.querySelector('.progress-bar');
    const progressSpan = progressBar.querySelector('span');
    const submitBtn = document.getElementById('submit-btn');
    const uploadForm = document.getElementById('upload-form');
    
    const vmHealthCheck = document.getElementById('vm-health-check');
    const healthStatusBadge = document.getElementById('health-status-badge');
    const healthCheckResult = document.getElementById('health-check-result');
    const unhealthyVmsAlert = document.getElementById('unhealthy-vms-alert');
    const unhealthyVmsList = document.getElementById('unhealthy-vms-list');
    const allHealthyAlert = document.getElementById('all-healthy-alert');
    
    let selectedProjectData = null;
    let allVmsHealthy = false;
    let currentFile = null;
    
    // 项目搜索功能
    function performProjectSearch(query) {
        if (!query || query.trim().length < 2) {
            projectSearchResults.style.display = 'none';
            return;
        }
        
        fetch(`/api/projects/search/?q=${encodeURIComponent(query)}&limit=10`)
            .then(response => response.json())
            .then(data => {
                const resultsList = projectSearchResults.querySelector('.list-group');
                resultsList.innerHTML = '';
                
                if (data.results && data.results.length > 0) {
                    projectSearchResults.style.display = 'block';
                    
                    data.results.forEach(project => {
                        const item = document.createElement('button');
                        item.type = 'button';
                        item.className = 'list-group-item list-group-item-action';
                        item.innerHTML = `
                            <div class="d-flex w-100 justify-content-between">
                                <h6 class="mb-1">${project.name}</h6>
                                <span class="badge bg-${project.status === 'active' ? 'success' : 'secondary'}">
                                    ${project.status === 'active' ? '活跃' : '已停用'}
                                </span>
                            </div>
                            <p class="mb-1">代码: ${project.code}</p>
                            <p class="mb-1">虚拟机: ${project.vm_count} 台</p>
                            <small class="text-muted">创建于: ${project.created_at}</small>
                        `;
                        
                        item.addEventListener('click', function() {
                            selectProject(project);
                            projectSearchResults.style.display = 'none';
                            projectSearchInput.value = project.name;
                        });
                        
                        resultsList.appendChild(item);
                    });
                } else {
                    projectSearchResults.style.display = 'block';
                    resultsList.innerHTML = `
                        <div class="list-group-item text-muted text-center py-3">
                            <i class="fas fa-search fa-lg mb-2"></i>
                            <p>未找到匹配的项目</p>
                        </div>
                    `;
                }
            })
            .catch(error => {
                console.error('项目搜索失败:', error);
                projectSearchResults.style.display = 'block';
                const resultsList = projectSearchResults.querySelector('.list-group');
                resultsList.innerHTML = `
                    <div class="list-group-item text-danger">
                        <i class="fas fa-exclamation-triangle"></i> 搜索失败，请重试
                    </div>
                `;
            });
    }
    
    // 选择项目
    function selectProject(project) {
        selectedProjectId.value = project.id;
        selectedProjectName.textContent = project.name;
        selectedProjectCode.textContent = `(${project.code})`;
        selectedProjectVmCount.textContent = project.vm_count;
        selectedProjectStatus.textContent = project.status === 'active' ? '活跃' : '已停用';
        selectedProjectInfo.style.display = 'block';
        selectedProjectData = project;
        
        // 清除之前的检查结果
        clearHealthCheck();
        
        // 检查虚拟机状态
        checkVmHealth(project.id);
        
        // 更新服务器列表
        updateServerList(project.id);
        
        // 更新按钮状态
        checkFormStatus();
    }
    
    // 清除项目选择
    function clearProjectSelection() {
        selectedProjectId.value = '';
        selectedProjectInfo.style.display = 'none';
        selectedProjectData = null;
        projectSearchInput.value = '';
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-upload"></i> 上传并更新';
        serverPreview.style.display = 'none';
        vmHealthCheck.style.display = 'none';
        clearHealthCheck();
        checkFormStatus();
    }
    
    // 检查虚拟机健康状态
    function checkVmHealth(projectId) {
        vmHealthCheck.style.display = 'block';
        healthCheckResult.innerHTML = `
            <div class="text-center py-3">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">检查中...</span>
                </div>
                <p class="mt-2">正在检查虚拟机状态...</p>
            </div>
        `;
        
        fetch(`/api/project/${projectId}/health-check/`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    displayHealthCheckResult(data);
                } else {
                    healthCheckResult.innerHTML = `
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-triangle"></i> ${data.message}
                        </div>
                    `;
                    allVmsHealthy = false;
                }
                // 检查表单状态
                checkFormStatus();
            })
            .catch(error => {
                console.error('健康检查失败:', error);
                healthCheckResult.innerHTML = `
                    <div class="alert alert-danger">
                        <i class="fas fa-exclamation-triangle"></i> 检查虚拟机状态失败，请稍后重试
                    </div>
                `;
                allVmsHealthy = false;
                checkFormStatus();
            });
    }
    
    // 显示健康检查结果
    function displayHealthCheckResult(data) {
        healthCheckResult.innerHTML = '';
        
        if (data.unhealthy_vms && data.unhealthy_vms.length > 0) {
            // 有异常虚拟机
            healthStatusBadge.className = 'badge bg-danger ms-2';
            healthStatusBadge.textContent = '异常';
            
            // 显示异常虚拟机列表
            let unhealthyHtml = '';
            data.unhealthy_vms.forEach(vm => {
                unhealthyHtml += `
                    <li>
                        <strong>${vm.name}</strong> (${vm.ip})
                        <span class="badge bg-${vm.status === 'running' ? 'success' : 'danger'} ms-2">
                            ${vm.status_display}
                        </span>
                        ${vm.host ? `<small class="text-muted ms-2">宿主机: ${vm.host}</small>` : ''}
                    </li>
                `;
            });
            
            unhealthyVmsList.innerHTML = unhealthyHtml;
            unhealthyVmsAlert.style.display = 'block';
            allHealthyAlert.style.display = 'none';
            
            allVmsHealthy = false;
        } else {
            // 所有虚拟机正常
            healthStatusBadge.className = 'badge bg-success ms-2';
            healthStatusBadge.textContent = '正常';
            
            unhealthyVmsAlert.style.display = 'none';
            allHealthyAlert.style.display = 'block';
            
            allVmsHealthy = true;
        }
        
        // 显示虚拟机状态表格
        if (data.vm_status_list && data.vm_status_list.length > 0) {
            let tableHtml = `
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead>
                            <tr>
                                <th>虚拟机名称</th>
                                <th>IP地址</th>
                                <th>状态</th>
                                <th>宿主机</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            data.vm_status_list.forEach(vm => {
                tableHtml += `
                    <tr class="${vm.is_running ? '' : 'table-danger'}">
                        <td>${vm.name}</td>
                        <td>${vm.ip}</td>
                        <td>
                            <span class="badge bg-${vm.is_running ? 'success' : 'danger'}">
                                ${vm.status_display}
                            </span>
                        </td>
                        <td>${vm.host || '未知'}</td>
                    </tr>
                `;
            });
            
            tableHtml += `
                        </tbody>
                    </table>
                </div>
                <div class="mt-2 text-muted small">
                    总计: ${data.total_vms} 台虚拟机 | 运行中: ${data.running_vms} 台
                </div>
            `;
            
            healthCheckResult.innerHTML = tableHtml;
        }
    }
    
    // 清除健康检查结果
    function clearHealthCheck() {
        vmHealthCheck.style.display = 'none';
        healthStatusBadge.className = 'badge bg-success ms-2';
        healthStatusBadge.textContent = '正常';
        unhealthyVmsAlert.style.display = 'none';
        allHealthyAlert.style.display = 'none';
        healthCheckResult.innerHTML = '';
        allVmsHealthy = false;
    }
    
    // 检查表单状态并更新按钮
    function checkFormStatus() {
        let isFormValid = true;
        let buttonText = '<i class="fas fa-upload"></i> 上传并更新';
        
        // 检查项目
        if (!selectedProjectId.value || !selectedProjectData) {
            isFormValid = false;
            buttonText = '请先选择项目';
        }
        // 检查虚拟机状态
        else if (!allVmsHealthy) {
            isFormValid = false;
            buttonText = '虚拟机状态异常';
        }
        // 检查项目状态
        else if (selectedProjectData && selectedProjectData.status !== 'active') {
            isFormValid = false;
            buttonText = '项目已停用';
        }
        // 检查文件
        else if (!fileInput.files.length) {
            isFormValid = false;
            buttonText = '请选择上传文件';
        }
        // 检查版本号
        else if (!versionInput.value.trim()) {
            isFormValid = false;
            buttonText = '请输入版本号';
        }
        // 检查包类型
        else if (!packageTypeSelect.value) {
            isFormValid = false;
            buttonText = '请选择包类型';
        }
        
        submitBtn.disabled = !isFormValid;
        submitBtn.innerHTML = buttonText;
        
        return isFormValid;
    }
    
    // 项目搜索事件绑定
    let searchTimeout;
    projectSearchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
            performProjectSearch(this.value.trim());
        }, 300);
    });
    
    projectSearchBtn.addEventListener('click', function() {
        performProjectSearch(projectSearchInput.value.trim());
    });
    
    // 点击其他地方隐藏搜索结果
    document.addEventListener('click', function(e) {
        if (!projectSearchResults.contains(e.target) && 
            !projectSearchInput.contains(e.target) && 
            !projectSearchBtn.contains(e.target)) {
            projectSearchResults.style.display = 'none';
        }
    });
    
    // 清除项目按钮
    clearProjectBtn.addEventListener('click', clearProjectSelection);
    
    // 文件选择变化时
    fileInput.addEventListener('change', function() {
        if (this.files.length > 0) {
            const file = this.files[0];
            currentFile = file;
            updateFileInfo(file);
        } else {
            currentFile = null;
            fileInfoCard.style.display = 'none';
        }
        checkFormStatus();
    });
    
    // 更新文件信息
    function updateFileInfo(file) {
        // 更新文件信息卡片
        document.getElementById('file-name').value = file.name;
        document.getElementById('file-size').value = formatFileSize(file.size);
        document.getElementById('file-type').value = file.type || getFileTypeFromExtension(file.name);
        fileInfoCard.style.display = 'block';
        
        // 自动填充版本号（从文件名提取）
        if (versionInput && !versionInput.value) {
            const versionMatch = file.name.match(/(\d+(\.\d+)+)/);
            if (versionMatch) {
                versionInput.value = 'V' + versionMatch[1];
            }
        }
    }
    
    // 根据文件扩展名获取文件类型
    function getFileTypeFromExtension(filename) {
        const ext = filename.split('.').pop().toLowerCase();
        const typeMap = {
            'war': 'Java Web应用程序',
            'zip': '压缩文件',
            'jar': 'Java归档文件',
            'exe': '可执行文件',
            'sh': 'Shell脚本',
            'tar': '归档文件',
            'gz': '压缩文件',
            'bz2': '压缩文件',
            '7z': '压缩文件',
            'rar': '压缩文件'
        };
        return typeMap[ext] || '未知文件类型';
    }
    
    // 格式化文件大小
    function formatFileSize(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
    }
    
    // 更新虚拟机列表
    function updateServerList(projectId) {
        if (!projectId) {
            serverPreview.style.display = 'none';
            return;
        }
        
        fetch(`/api/project/${projectId}/vm-status/`)
            .then(response => {
                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                if (data.success) {
                    serverList.innerHTML = '';
                    
                    if (data.vm_status_list && data.vm_status_list.length > 0) {
                        data.vm_status_list.forEach(vm => {
                            const serverCol = document.createElement('div');
                            serverCol.className = 'col-md-6 mb-3';
                            serverCol.innerHTML = `
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center mb-2">
                                            <div class="flex-shrink-0">
                                                <i class="fas fa-server fa-2x text-${vm.is_healthy ? 'success' : 'danger'}"></i>
                                            </div>
                                            <div class="flex-grow-1 ms-3">
                                                <h6 class="mb-0">${vm.name}</h6>
                                                <small class="text-muted">${vm.ip}</small>
                                            </div>
                                        </div>
                                        <div class="small">
                                            <div class="mb-1">
                                                <i class="fas fa-microchip"></i> 虚拟机
                                            </div>
                                            <div class="mb-1">
                                                <i class="fas fa-plug"></i> 
                                                <span class="badge bg-${vm.is_healthy ? 'success' : 'danger'}">
                                                    ${vm.is_healthy ? '在线' : '离线'}
                                                </span>
                                            </div>
                                            <div>
                                                <i class="fas fa-home"></i> 
                                                宿主机: ${vm.host || '未知'}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            `;
                            serverList.appendChild(serverCol);
                        });
                        
                        serverCount.textContent = data.vm_status_list.length;
                        serverPreview.style.display = 'block';
                        noServersAlert.style.display = 'none';
                    } else {
                        serverPreview.style.display = 'block';
                        noServersAlert.style.display = 'block';
                    }
                } else {
                    serverPreview.style.display = 'block';
                    noServersAlert.style.display = 'block';
                    noServersAlert.innerHTML = `<i class="fas fa-exclamation-triangle"></i> ${data.message || '加载虚拟机列表失败'}`;
                }
            })
            .catch(error => {
                console.error('加载虚拟机列表失败:', error);
                serverPreview.style.display = 'block';
                noServersAlert.style.display = 'block';
                noServersAlert.innerHTML = `<i class="fas fa-exclamation-triangle"></i> 加载虚拟机列表失败，请稍后重试`;
            });
    }
    
    // 版本号输入变化
    versionInput.addEventListener('input', checkFormStatus);
    
    // 包类型选择变化
    packageTypeSelect.addEventListener('change', checkFormStatus);
    
    // 表单提交处理
    uploadForm.addEventListener('submit', function(e) {
        e.preventDefault();
        e.stopPropagation();
        
        // 验证表单
        if (!validateForm()) {
            return false;
        }
        
        // 禁用提交按钮
        const originalHtml = submitBtn.innerHTML;
        submitBtn.disabled = true;
        
        // 显示进度条
        uploadProgress.style.display = 'block';
        progressBar.style.width = '0%';
        progressSpan.textContent = '0%';
        
        // 创建FormData
        const formData = new FormData(this);
        
        // 添加选项
        formData.append('auto_deploy', 'true');
        formData.append('cleanup_files', 'true');
        formData.append('health_check', 'true'); 
        
        // 使用 XMLHttpRequest 来支持进度监控
        const xhr = new XMLHttpRequest();
        const uploadUrl = this.action || window.location.pathname;
        
        // 配置请求
        xhr.open('POST', uploadUrl, true);
        xhr.setRequestHeader('X-CSRFToken', document.querySelector('[name=csrfmiddlewaretoken]').value);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        
        // 上传进度事件
        xhr.upload.addEventListener('progress', function(event) {
            if (event.lengthComputable) {
                const percentComplete = Math.round((event.loaded / event.total) * 100);
                progressBar.style.width = percentComplete + '%';
                progressSpan.textContent = percentComplete + '%';
                progressBar.setAttribute('aria-valuenow', percentComplete);
                
                // 更新按钮文本显示进度
                submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> 上传中 ${percentComplete}%`;
            }
        });
        
        // 请求完成
        xhr.addEventListener('load', function() {
            if (xhr.status === 200) {
                try {
                    const data = JSON.parse(xhr.responseText);
                    console.log('响应数据:', data);
                    
                    if (data.success) {
                        submitBtn.innerHTML = '<i class="fas fa-check"></i> 上传成功';
                        progressBar.style.width = '100%';
                        progressSpan.textContent = '100%';
                        showAlert('文件上传成功！更新任务已开始执行。', 'success');
                        
                        // 重定向到任务详情页
                        setTimeout(() => {
                            if (data.redirect_url) {
                                window.location.href = data.redirect_url;
                            } else {
                                window.location.href = "{% url 'task_list' %}";
                            }
                        }, 2000);
                    } else {
                        submitBtn.innerHTML = originalHtml;
                        submitBtn.disabled = false;
                        uploadProgress.style.display = 'none';
                        
                        let errorMessage = data.message || '上传失败';
                        if (data.errors) {
                            try {
                                const errors = JSON.parse(data.errors);
                                const errorDetails = Object.entries(errors).map(([field, msgs]) => 
                                    `${field}: ${msgs.join(', ')}`
                                ).join('; ');
                                errorMessage += ' - ' + errorDetails;
                            } catch (e) {
                                console.error('解析错误信息失败:', e);
                            }
                        }
                        showAlert(errorMessage, 'danger');
                    }
                } catch (error) {
                    console.error('解析响应失败:', error);
                    submitBtn.innerHTML = originalHtml;
                    submitBtn.disabled = false;
                    uploadProgress.style.display = 'none';
                    showAlert('上传失败，服务器响应格式错误。', 'danger');
                }
            } else {
                // 处理非200状态码
                submitBtn.innerHTML = originalHtml;
                submitBtn.disabled = false;
                uploadProgress.style.display = 'none';
                if (xhr.status === 413) {
                    showAlert('文件太大，超过服务器限制！', 'danger');
                } else {
                    showAlert(`上传失败: HTTP ${xhr.status}`, 'danger');
                }
            }
        });
        
        // 请求错误
        xhr.addEventListener('error', function() {
            console.error('上传失败: 网络错误');
            submitBtn.innerHTML = originalHtml;
            submitBtn.disabled = false;
            uploadProgress.style.display = 'none';
            showAlert('上传失败: 网络错误', 'danger');
        });
        
        // 请求超时
        xhr.addEventListener('timeout', function() {
            console.error('上传失败: 请求超时');
            submitBtn.innerHTML = originalHtml;
            submitBtn.disabled = false;
            uploadProgress.style.display = 'none';
            showAlert('上传失败: 请求超时', 'danger');
        });
        
        // 发送请求
        xhr.send(formData);
        
        return false;
    });
    
    // 表单验证
    function validateForm() {
        return checkFormStatus(); // 使用相同的验证逻辑
    }
    
    // 显示提示信息
    function showAlert(message, type) {
        // 移除现有提示
        const existingAlert = document.querySelector('.alert-dismissible');
        if (existingAlert) {
            existingAlert.remove();
        }
        
        // 创建新提示
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} alert-dismissible fade show mt-3`;
        alertDiv.innerHTML = `
            ${message}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;
        
        // 插入到表单上方
        uploadForm.parentNode.insertBefore(alertDiv, uploadForm);
    }
    
    // 初始检查表单状态
    checkFormStatus();
});
</script>
{% endblock %}
